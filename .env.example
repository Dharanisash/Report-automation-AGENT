# =====================================================================
# Packaging Reporting Agent - Environment Configuration
# =====================================================================

# --- OpenAI LLM Configuration ---
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.0

# --- State Store Database ---
DB_PATH=packaging_agent_state.db

# --- ServiceNow Configuration ---
SNOW_INSTANCE_URL=https://your-organization.service-now.com
SNOW_USERNAME=svc_packaging_agent
SNOW_PASSWORD=your_secure_password
SNOW_ASSIGNMENT_GROUP=ITSC_WW_RNTBCI_DIR-ICS_Software_Packaging

# --- Microsoft Intune / Graph API Configuration ---
INTUNE_TENANT_ID=your-azure-tenant-id-guid
INTUNE_CLIENT_ID=your-azure-client-id-guid
INTUNE_CLIENT_SECRET=your-azure-client-secret-value

# --- ADT (Application Deployment Tracker) Fallback ---
ADT_API_ENDPOINT=https://adt.internal.corp/api/v1/telemetry
ADT_API_TOKEN=your-adt-bearer-token

# --- Email Notification (SMTP or Graph) ---
EMAIL_TRANSPORT=mock  # Options: mock | smtp | graph
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=packaging-reporting@your-domain.com
SMTP_PASSWORD=your_smtp_app_password
EMAIL_FROM_ADDRESS=packaging-reporting@your-domain.com

# --- Execution Mode ---
# When set to true, external API calls return simulated realistic data
MOCK_EXTERNAL_SERVICES=true
LOG_LEVEL=INFO
